{
  "type": "panel",
  "items": {
    "notice": {
      "type": "staticText",
      "newLine": true,
      "text": "Nach der Installation Weboberfläche → Einstellungen → Systemeinrichtung öffnen. Netwatch prüft tshark, dumpcap und Capture-Rechte automatisch und zeigt kopierbare Befehle. Der Adapter selbst läuft niemals als root."
    },
    "captureInterface": {
      "type": "text",
      "label": "Capture interface",
      "help": "Beispiel: eth0. Die Weboberfläche zeigt alle erkannten Interfaces."
    },
    "autoStart": { "type": "checkbox", "label": "Capture automatisch starten" },
    "memoryPacketLimit": {
      "type": "select",
      "label": "Maximale Pakete im RAM",
      "options": [
        { "label": "10.000", "value": 10000 },
        { "label": "50.000", "value": 50000 },
        { "label": "100.000", "value": 100000 }
      ]
    },
    "captureDirectory": {
      "type": "text",
      "label": "Capture-Verzeichnis",
      "help": "Leer = ioBroker-Datenverzeichnis"
    },
    "maxCaptureSizeMb": {
      "type": "number",
      "label": "Maximale Capture-Dateigröße (MB)",
      "min": 10,
      "max": 2048
    },
    "maxTotalStorageMb": {
      "type": "number",
      "label": "Maximaler Gesamtspeicher (MB)",
      "min": 100,
      "max": 102400
    },
    "retentionDays": {
      "type": "number",
      "label": "Aufbewahrung (Tage)",
      "min": 1,
      "max": 365
    },
    "webEnabled": { "type": "checkbox", "label": "Weboberfläche aktivieren" },
    "webBind": {
      "type": "text",
      "label": "Bind-Adresse",
      "help": "127.0.0.1 ist nur lokal; 0.0.0.0 gibt den Dienst im LAN frei und erfordert ein starkes Passwort"
    },
    "webPort": {
      "type": "number",
      "label": "Web-Port",
      "min": 1024,
      "max": 65535
    },
    "webUsername": { "type": "text", "label": "Web-Benutzername" },
    "webPassword": { "type": "password", "label": "Web-Passwort" },
    "statisticsIntervalSec": {
      "type": "number",
      "label": "Statistikintervall (Sekunden)",
      "min": 1,
      "max": 60
    }
  }
}
